# Copy to .env for Docker Compose. The standalone binary reads process
# environment variables or --config JSON; it does not load .env automatically.

# Required for the Compose console. Choose your own password before starting.
WEB_USER=admin
WEB_PASSWORD=

# Model endpoint: openai (any compatible /v1 endpoint) or ollama.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# For a local Ollama server, set AI_PROVIDER=ollama and choose an installed model.
# Inside Docker, localhost refers to the container. Use a reachable host address.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=

# Used by the standalone binary; Compose fixes the container port to 8080.
PORT=8080
WEB_UI_PORT=8899

# Optional notifications consumed by the current command-line/web entrypoint.
DINGTALK_WEBHOOK=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
